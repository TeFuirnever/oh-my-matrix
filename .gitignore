node_modules/
omm-dist/
*.tsbuildinfo
coverage/
.omc/
.omx/
website/.vitepress/dist/
.DS_Store
**/.DS_Store

# 编译产物（不入库，通过 prepublishOnly 在发布时构建）
packages/*/dist/

# pnpm 本地存储（不入库）
.pnpm-store/

# pnpm pack 产物（构建产物，不入库；MA 引用各自仓内的副本）
packages/*/*.tgz

# 工具索引产物（codegraph / context engine），不入库
.codegraph/
.context/

# permission-policy audit 产物（测试/运行时 appendAuditEntry 写入 cwd），不入库
.autopilot/

# dynamic-workflows skill 运行时产物（生成的 .prose 程序 + 建议的 OpenProse runs 目录）
.openclaw/

# Claude Code 本地设置（含机器本地路径/权限/历史命令，不入库）
.claude/settings.local.json
