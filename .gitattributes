# Prevent core.autocrlf=true from churning text files on Windows
* text=auto eol=lf

# Force LF for all source/build outputs we ship in the repo
*.js text eol=lf
*.ts text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.sh text eol=lf

# Binary
*.tgz binary
*.zip binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
