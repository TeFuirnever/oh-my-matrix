{
  "id": "omm",
  "name": "omm",
  "version": "0.5.0",
  "apiVersion": "0.3",
  "description": "OpenClaw-native orchestration extension: state, hooks, agent prompts, skills, and MCP servers.",
  "hooks": [
    "session_start", "session_end",
    "before_tool_call", "after_tool_call",
    "llm_input", "llm_output",
    "agent_end",
    "subagent_spawning", "subagent_spawned", "subagent_ended",
    "gateway_start", "gateway_stop",
    "before_compaction", "after_compaction"
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "stateRoot": {
        "type": "string"
      },
      "promptsDir": {
        "type": "string"
      }
    }
  }
}
