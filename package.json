{
  "name": "omm",
  "version": "0.8.0",
  "private": true,
  "description": "oh-my-matrix — documentation & design repository (OpenClaw-native orchestration)",
  "license": "MIT",
  "author": "TeFuirnever",
  "homepage": "https://tefuirnever.github.io/oh-my-matrix/",
  "repository": {
    "type": "git",
    "url": "https://github.com/TeFuirnever/oh-my-matrix.git"
  },
  "bugs": {
    "url": "https://github.com/TeFuirnever/oh-my-matrix/issues"
  },
  "keywords": [
    "openclaw",
    "dynamic-workflows",
    "ai-orchestration",
    "multi-agent",
    "subagent",
    "runtime-guard",
    "skill",
    "openprose"
  ],
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "docs:dev": "vitepress dev website",
    "docs:build": "vitepress build website",
    "docs:preview": "vitepress preview website",
    "lint": "eslint .",
    "lint:md": "markdownlint-cli2",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm lint && pnpm lint:md && pnpm typecheck",
    "verify": "pnpm check && pnpm -r test && pnpm docs:build",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-plugin-versions.cjs",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "markdownlint-cli2": "^0.23.2",
    "simple-git-hooks": "^2.13.1",
    "typescript-eslint": "^8.65.0",
    "vitepress": "^1.6.4"
  },
  "simple-git-hooks": {
    "commit-msg": "npx --no -- commitlint --edit \"$1\""
  }
}
