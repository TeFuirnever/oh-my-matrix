{
  "name": "omm",
  "version": "0.4.2",
  "private": true,
  "description": "OpenClaw-native orchestration extension suite",
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "build": "node omm-scripts/generate-mcp-inlines.mjs && pnpm --filter omm-plugin build && pnpm --filter omm-mcp build && pnpm --filter omm-mcp-memory build && pnpm --filter omm-mcp-trace build && node omm-scripts/omm-build-suite.mjs",
    "lint": "biome check .",
    "test": "node --test omm-scripts/*.test.mjs $(find omm-packages -path '*/dist/*.test.js' -not -path '*/node_modules/*')",
    "test:coverage": "npx -y c8 --reporter=text-summary --reporter=text --include='omm-packages/**/dist/src/**/*.js' --exclude='**/*.test.js' --exclude='**/*.d.ts' pnpm test",
    "omm:scan-names": "node omm-scripts/omm-scan-names.mjs .",
    "omm:verify-bundle": "node omm-scripts/omm-verify-bundle.mjs omm-dist/omm-suite-0.4.2.tgz",
    "omm:verify-provenance": "node omm-scripts/omm-verify-provenance.mjs",
    "omm:smoke-mcp": "node omm-scripts/omm-smoke-mcp.mjs",
    "omm:ma-seed": "node omm-scripts/omm-ma-seed.mjs",
    "omm:openclaw-seed": "node omm-scripts/omm-openclaw-seed.mjs",
    "omm:generate-inlines": "node omm-scripts/generate-mcp-inlines.mjs",
    "omm:generate-inlines:check": "node omm-scripts/generate-mcp-inlines.mjs --check",
    "omm:verify-drift": "node omm-scripts/verify-mcp-drift.mjs",
    "docs:dev": "vitepress dev website",
    "docs:build": "vitepress build website",
    "docs:preview": "vitepress preview website"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitepress": "^1.6.4"
  }
}
