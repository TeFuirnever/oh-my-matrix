{
  "name": "@oh-my-matrix/dynamic-workflows",
  "version": "0.1.4",
  "description": "Dynamic Workflows: runtime subagent guard (before_tool_call priority 11, fail-closed destructive-op blocking for :subagent: sessions) + LLM-driven orchestration skill (.prose generation, 11 patterns, role-prompt templates). Imports permission primitives from @oh-my-matrix/permission-policy.",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TeFuirnever/oh-my-matrix.git",
    "directory": "packages/dynamic-workflows"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "skill"
  ],
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "plugin": true,
    "hooks": [
      "before_tool_call"
    ]
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "pack": "pnpm pack",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "openclaw": ">=2026.5.28 <2027",
    "@oh-my-matrix/permission-policy": "^0.1.2"
  },
  "devDependencies": {
    "openclaw": "2026.5.28",
    "@oh-my-matrix/permission-policy": "workspace:*",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0",
    "@types/node": "^22.0.0"
  }
}
