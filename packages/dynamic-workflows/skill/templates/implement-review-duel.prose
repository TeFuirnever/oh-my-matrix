# Implement a change, then a reviewer tries to refute it; revise until it survives
# Customize: replace the task description, the ownership boundary, and the verify command
# Bound: this is a one-shot DAG (max 3 rounds), NOT an autonomous loop. For cross-turn
#        fix-until-green, use the host Autopilot, not this pattern.
# Safety: the builder owns a DISJOINT file set — declare it in the prompt and never let
#         parallel builders touch shared files (anti-patterns.md § Parallel writes).
# Note: syntactically validated against the 5-check in SKILL.md Step 3; not yet executed
#       end-to-end through OpenProse (no fixture run). Verify semantics after first real use.
# Refute gate: reviewer FAIL = REFUTED (revise); reviewer SURVIVES = the implementation
#              survives the refute pass. A final review runs AFTER the loop so the
#              synthesis verdict is evidence-backed, not inferred from the candidate alone.

# WARNING: agent prompts below are Step 1.5 placeholders — replace each
# "<Copy Prompt text from references/role-prompts/<role>.md>" with the actual
# Prompt text from that file BEFORE running (SKILL.md Step 1.5 + Step 3 check).

input task: "The change to implement"
input ownership: "The file set this builder may modify — others must not be touched"
input verify_cmd: "The command that proves the change works (e.g. build, test)"

# executor 角色（标准角色）—— prompt 从 references/role-prompts/executor.md 拷贝（Step 1.5）
agent executor:
  model: sonnet
  prompt: "<Copy Prompt text from references/role-prompts/executor.md>"

# code-reviewer 角色（标准角色）—— prompt 从 references/role-prompts/code-reviewer.md 拷贝（Step 1.5）
agent code-reviewer:
  model: opus
  prompt: "<Copy Prompt text from references/role-prompts/code-reviewer.md>"

let current = session: executor
  prompt: "Implement the task provided in context with the smallest viable diff. You may ONLY modify files in the ownership set; never touch shared files. Run the verify command and include its fresh output. If 3 attempts fail, stop and report."
  context: { task, ownership, verify_cmd }

block improve(candidate, rounds_left):
  if rounds_left <= 0:
    output candidate

  let review = session: code-reviewer
    prompt: "Stage 1: spec compliance — does the implementation cover ALL requirements? Stage 2: code quality — logic correctness, error handling, anti-patterns. Rate each issue by severity (CRITICAL/HIGH/MEDIUM/LOW) with file:line and a concrete fix. Emit SURVIVES only if you cannot find a reason it would fail; otherwise REFUTED with specific issues. Default to skepticism."
    context: { task, candidate }

  if **the review verdict is SURVIVES with no critical or high issues**:
    output candidate

  let revised = session: executor
    prompt: "The review refuted the implementation with these issues. Fix them. Re-run the verify command and show fresh output."
    context: { candidate, review, ownership, verify_cmd }

  # Recurse: the revised candidate goes through another review round until it
  # survives or the round budget runs out. The result is returned, not re-bound.
  output do improve(revised, rounds_left - 1)

let settled = do improve(current, 3)

# Final review runs OUTSIDE the block so its verdict reaches synthesis as evidence.
let final_review = session: code-reviewer
  prompt: "Give a final verdict on this implementation. Emit SURVIVES if it is correct and complete, or REFUTED with specific issues."
  context: { task, settled }

session "Synthesize final result. Use the final_review verdict in context to label the outcome: verified if SURVIVED, partial if REFUTED. Report the review issues and the builder's verify output."
  context: { task, settled, final_review }
