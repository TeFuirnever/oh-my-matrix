# Generate candidate tests, filter to the meaningful ones, implement, verify completeness
# Customize: replace the target module and the rubric the filter applies
# Refute gate: the filter step is the refute pass — candidates that don't pass the rubric
#              are REFUTED; survivors are written and verified.
# Note: syntactically validated against the 5-check in SKILL.md Step 3; not yet executed
#       end-to-end through OpenProse (no fixture run). Verify semantics after first real use.

# WARNING: agent prompts below are Step 1.5 placeholders — replace each
# "<Copy Prompt text from references/role-prompts/<role>.md>" with the actual
# Prompt text from that file BEFORE running (SKILL.md Step 1.5 + Step 3 check).

input target: "The module or behavior to test"
input rubric: "What makes a test case worth keeping (e.g. covers a real edge, verifies one behavior, matches existing test style)"

# test-engineer 角色（标准角色）—— prompt 从 references/role-prompts/test-engineer.md 拷贝（Step 1.5）
agent test-engineer:
  model: sonnet
  prompt: "<Copy Prompt text from references/role-prompts/test-engineer.md>"

# critic 角色（标准角色）—— prompt 从 references/role-prompts/critic.md 拷贝（Step 1.5）
agent critic:
  model: opus
  prompt: "<Copy Prompt text from references/role-prompts/critic.md>"

let candidates = session: test-engineer
  prompt: "Generate test case ideas for the target in context. Overproduce diverse candidates — broad coverage of edge cases, error paths, boundary conditions, integration points. For each idea, name the behavior it verifies and why it matters."
  context: { target, rubric }

let good = candidates | filter:
  session: critic
    prompt: "Apply the rubric strictly: answer NO for any candidate that does not cover a real edge, duplicates another candidate's behavior, or does not match the codebase test style. Answer YES only for candidates that clear the rubric. Default to NO when uncertain. Answer YES or NO only."
    context: { item, rubric }

let tests = good | pmap:
  session: test-engineer
    prompt: "Write one focused test for this surviving idea that verifies exactly one behavior. Match existing test patterns in the codebase — read existing tests first for framework, structure, naming, setup/teardown. Run the tests and show fresh output."
    context: { item, target }

let gaps = session "Which behaviors of the target are still uncovered by these tests?"
  context: { target, tests }

session "Synthesize — report the surviving tests, note how many candidates were filtered out by the rubric, and list coverage gaps"
  context: { target, tests, gaps }
